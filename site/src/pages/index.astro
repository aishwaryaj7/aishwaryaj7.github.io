---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Trajectory from '../components/Trajectory.astro';
import EmbeddingMap from '../components/EmbeddingMap.astro';
import ScrollRails from '../components/ScrollRails.astro';
import { site } from '../data/site';
import { getProjects, getPosts, readingTime, formatMonth } from '../lib/content';

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const rest = projects.filter((p) => !p.data.featured);
const posts = await getPosts();
---

<Base>
  <!-- Hero, over a map of everything I've written -->
  <div class="hero-wrap">
  <EmbeddingMap />
  <section class="hero container">
    {site.openToWork && (
      <p class="status rise">
        <span class="dot" aria-hidden="true"></span>
        Open to new roles · {site.location}
      </p>
    )}
    <h1 class="hero-title serif rise" style="--i:1">
      I build machine learning and LLM systems, and see them <em>all the way into production.</em>
    </h1>
    <p class="hero-lede rise" style="--i:2">
      I'm {site.shortName}, a machine learning engineer in {site.location} with 5+ years across applied research,
      e-commerce and enterprise software. Now I'm focused on LLM engineering, with hands-on projects in RAG and agents.
    </p>
    <div class="hero-actions rise" style="--i:3">
      <a class="btn btn-primary" href="#work">See my work</a>
      <span class="socials">
        <span class="divider" aria-hidden="true"></span>
        <a class="social" href={site.github} target="_blank" rel="noopener"><Icon name="github" label="GitHub" size={18} /></a>
        <a class="social" href={site.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" label="LinkedIn" size={18} /></a>
        <a class="social" href={`mailto:${site.email}`}><Icon name="mail" label="Email" size={18} /></a>
      </span>
    </div>
  </section>
  </div>

  <!-- Work -->
  <section class="section container" id="work" aria-labelledby="work-title">
    <div class="section-head">
      <h2 id="work-title">Selected work</h2>
      <span class="count">{String(projects.length).padStart(2, '0')} projects</span>
    </div>
    <div class="tiles" data-scroller>
      {featured.map((p) => <ProjectCard project={p} featured />)}
      {rest.map((p, i) => <ProjectCard project={p} full={i === 0} />)}
    </div>
  </section>

  <!-- Writing -->
  <section class="section container" id="writing" aria-labelledby="writing-title">
    <div class="section-head">
      <h2 id="writing-title">Writing</h2>
      <span class="count">{String(posts.length).padStart(2, '0')} posts</span>
    </div>
    <div class="tiles" data-scroller>
      {posts.map((post, i) => (
        <a class:list={['post-tile', { lead: i === 0 }]} href={`/blog/${post.id}`}>
          {i === 0 && <span class="eyebrow">Latest</span>}
          <span class="post-title">{post.data.title}</span>
          <span class="post-desc">{post.data.description}</span>
          <span class="post-meta">
            <time datetime={post.data.date.toISOString()}>{formatMonth(post.data.date)}</time>
            <span aria-hidden="true">·</span>
            <span>{readingTime(post)} min read</span>
            <Icon name="arrow-up-right" size={14} />
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Career -->
  <section class="section container" id="career" aria-labelledby="career-title">
    <div class="section-head">
      <h2 id="career-title">Career</h2>
      <span class="legend" aria-hidden="true">
        <span><i class="k-work"></i>Work</span>
        <span><i class="k-study"></i>Education</span>
      </span>
    </div>
    <Trajectory />
  </section>

  <ScrollRails />

  <!-- Contact -->
  <section class="container contact" id="contact" aria-labelledby="contact-title">
    <div class="contact-card">
      <div>
        <h2 id="contact-title" class="serif">Let's talk.</h2>
        <p>Hiring for an AI or ML role, or want to discuss a project? Email is the fastest way to reach me.</p>
      </div>
      <div class="contact-actions">
        <a class="btn btn-primary" href={`mailto:${site.email}`}><Icon name="mail" />Email me</a>
        <a class="btn" href={site.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" />LinkedIn</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero-wrap {
    position: relative;
    margin-top: calc(-1 * var(--header-h));
    padding-top: var(--header-h);
    border-bottom: 1px solid var(--border);
  }

  .hero {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    min-height: clamp(480px, 68vh, 620px);
    padding-top: clamp(40px, 6vw, 72px);
    padding-bottom: clamp(48px, 6vw, 72px);
    /* Let the pointer reach the map behind; links and buttons opt back in */
    pointer-events: none;
  }

  .hero :global(a),
  .hero :global(button) {
    pointer-events: auto;
  }

  .hero-title,
  .hero-lede {
    text-shadow: 0 0 24px var(--bg), 0 0 2px var(--bg);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
    padding: 4px 12px 4px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    font-size: 13px;
    color: var(--text-muted);
  }

  .dot {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--positive);
  }

  @media (prefers-reduced-motion: no-preference) {
    .dot::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: var(--positive);
      animation: ping 2.4s ease-out infinite;
    }

    @keyframes ping {
      0% { transform: scale(1); opacity: 0.6; }
      70%, 100% { transform: scale(2.6); opacity: 0; }
    }
  }

  .hero-title {
    max-width: 16ch;
    font-size: clamp(34px, 4.8vw, 56px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  .hero-title em {
    font-style: normal;
    color: var(--text-muted);
  }

  .hero-lede {
    max-width: 50ch;
    margin-top: 22px;
    font-size: clamp(15.5px, 1.5vw, 17.5px);
    color: var(--text-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
  }

  .socials {
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }

  .divider {
    width: 1px;
    height: 20px;
    margin-inline: 6px;
    background: var(--border-strong);
  }

  .social {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    color: var(--text-muted);
    transition: color 0.15s, background-color 0.15s;
  }

  .social:hover {
    color: var(--text);
    background: var(--bg-subtle);
  }

  @media (max-width: 760px) {
    .hero {
      min-height: 0;
    }
  }

  @media (max-width: 480px) {
    .socials {
      flex-basis: 100%;
      margin-left: -10px;
    }

    .divider {
      display: none;
    }
  }

  /* Tiles: 3 columns, the first tile spans 2 → two rows for 5 items */
  .tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .tiles > :global(.featured),
  .tiles > .lead {
    grid-column: span 2;
  }

  .swipe {
    display: none;
  }

  @media (max-width: 900px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Phones: side-by-side tiles you swipe through instead of a long stack */
  @media (max-width: 640px) {
    .tiles {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 84%;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      margin-inline: calc(-1 * var(--gutter));
      padding: 2px var(--gutter) 6px;
      scrollbar-width: none;
    }

    .tiles::-webkit-scrollbar {
      display: none;
    }

    .tiles > :global(*),
    .tiles > :global(.featured),
    .tiles > .lead {
      grid-column: auto;
      scroll-snap-align: start;
    }

    .swipe {
      display: inline;
    }
  }

  /* Writing tiles */
  .post-tile {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .post-tile:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow);
  }

  .post-tile .eyebrow {
    color: var(--accent);
  }

  .post-title {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.015em;
    transition: color 0.15s;
  }

  .post-tile:hover .post-title {
    color: var(--accent);
  }

  .post-desc {
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding-top: 6px;
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--text-faint);
  }

  .post-meta :global(svg) {
    margin-left: auto;
    transition: transform 0.2s var(--ease), color 0.15s;
  }

  .post-tile:hover .post-meta :global(svg) {
    color: var(--text);
    transform: translate(2px, -2px);
  }

  .lead {
    padding: 24px 26px;
    background:
      radial-gradient(90% 120% at 100% 0%, var(--accent-soft), transparent 60%),
      var(--surface);
  }

  .lead .post-title {
    max-width: 26ch;
    font-family: var(--font-sans);
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  .lead .post-desc {
    max-width: 62ch;
    font-size: 15px;
  }

  /* Career legend */
  .legend {
    display: inline-flex;
    gap: 14px;
    font-family: var(--font-sans);
    font-size: 11.5px;
    color: var(--text-faint);
  }

  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .legend i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .legend .swipe {
    display: none;
  }

  @media (max-width: 820px) {
    .legend .swipe {
      display: inline-flex;
    }
  }

  .k-work {
    background: var(--text);
  }

  .k-study {
    border: 1.5px solid var(--text-muted);
  }

  /* Contact */
  .contact {
    padding-top: clamp(36px, 6vw, 64px);
    padding-bottom: clamp(40px, 6vw, 72px);
  }

  .contact-card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
    padding: clamp(22px, 4vw, 32px) clamp(22px, 4vw, 36px);
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) + 4px);
    background:
      radial-gradient(120% 160% at 100% 0%, var(--accent-soft), transparent 55%),
      var(--surface);
  }

  .contact-card h2 {
    font-size: clamp(30px, 4vw, 40px);
    line-height: 1.05;
  }

  .contact-card p {
    max-width: 48ch;
    margin-top: 6px;
    font-size: 15px;
    color: var(--text-muted);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
</style>
