---
// Small generated illustration at the top of each project card. Where possible it is drawn from
// the project's real data (see scripts/build-data.mjs); the caption says what it shows.
import energy from '../data/generated/energy-prices.json';
import wave from '../data/generated/waveform.json';

interface Props {
  slug: string;
  tall?: boolean;
}
const { slug, tall = false } = Astro.props;
const W = 400;
const H = 100;

const topicBySlug: Record<string, string> = {
  listingaudit: 'agents',
  'energy-price-forecasting': 'mlops',
  doctract: 'rag',
  'doc-parser': 'rag',
  speech2text: 'speech',
};
const topic = topicBySlug[slug] ?? 'rag';

/* ListingAudit: rule names from rulebook/checklist.yaml, as an audit checklist */
const checklist: [string, boolean][] = [
  ['Honest discounts', false],
  ['Who made it', true],
  ['EU contact named', true],
  ['Safety warnings', true],
  ['Unit price', true],
  ['Truthful photos', false],
];

/* Energy: one real day of prices */
const prices = energy.prices;
const pMin = Math.min(...prices);
const pMax = Math.max(...prices);
const px = (i: number) => 8 + (i / (prices.length - 1)) * (W - 16);
const py = (v: number) => 86 - ((v - pMin) / (pMax - pMin)) * 66;
const pricePath = prices.map((v, i) => `${i ? 'L' : 'M'}${px(i).toFixed(1)},${py(v).toFixed(1)}`).join('');
const iMin = prices.indexOf(pMin);
const iMax = prices.indexOf(pMax);
const hh = (i: number) => `${String(Math.floor(i / 4)).padStart(2, '0')}:${String((i % 4) * 15).padStart(2, '0')}`;
const day = new Date(energy.day).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

/* Speech: amplitude envelope of the test recording */
const bins = wave.bins;
const bw = (W - 16) / bins.length;

const captions: Record<string, string> = {
  listingaudit: 'EU rules checked on every listing',
  'energy-price-forecasting': `DE-LU day-ahead · ${day} · €${Math.round(pMin)}–${Math.round(pMax)}/MWh · SMARD.de`,
  speech2text: 'test_audio.mp3 · 33 s · RMS envelope',
  doctract: 'pdf → chunks → pgvector → local LLM',
  'doc-parser': 'page → text · images · tables',
};
---

<div class:list={['cover', `t-${topic}`, { tall }]} aria-hidden="true">
  {slug === 'listingaudit' ? (
    <ul class="checks">
      {checklist.map(([rule, ok]) => (
        <li class:list={{ bad: !ok }}>
          <span class="mark">{ok ? '✓' : '✕'}</span>
          {rule}
        </li>
      ))}
    </ul>
  ) : (
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet">
    {slug === 'energy-price-forecasting' && (
      <g class="prices">
        <defs>
          <linearGradient id="price-fill" x1="0" x2="0" y1="0" y2="1">
            <stop offset="0" stop-color="var(--c)" stop-opacity="0.35" />
            <stop offset="1" stop-color="var(--c)" stop-opacity="0" />
          </linearGradient>
        </defs>
        {[0, 24, 48, 72, 95].map((i) => <line class="tick" x1={px(i)} x2={px(i)} y1="14" y2="90" />)}
        <path d={`${pricePath}L${px(prices.length - 1)},92L${px(0)},92Z`} fill="url(#price-fill)" />
        <path class="line" d={pricePath} />
        <circle cx={px(iMax)} cy={py(pMax)} r="3" class="mark" />
        <circle cx={px(iMin)} cy={py(pMin)} r="3" class="mark" />
        <text x={px(iMax)} y={py(pMax) - 7} text-anchor="middle">{hh(iMax)}</text>
        <text x={px(iMin)} y={py(pMin) + 13} text-anchor="middle">{hh(iMin)}</text>
      </g>
    )}

    {slug === 'speech2text' && (
      <g class="wave">
        {bins.map((v, i) => {
          const h = Math.max(1.5, v * 72);
          return <rect x={8 + i * bw} y={50 - h / 2} width={Math.max(0.8, bw - 0.9)} height={h} rx="0.6" />;
        })}
      </g>
    )}

    {slug === 'doctract' && (
      <g class="rag">
        <rect class="page" x="20" y="16" width="56" height="70" rx="4" />
        {[26, 34, 42, 50, 58, 66, 74].map((y, i) => <line class="txt" x1="28" x2={i % 3 === 2 ? 56 : 68} y1={y} y2={y} />)}
        <path class="flow" d="M86,51 H112" />
        {[18, 34, 50, 66].map((y) => <rect class="chunk" x="120" y={y} width="44" height="12" rx="2.5" />)}
        <path class="flow" d="M172,51 H198" />
        {Array.from({ length: 6 }, (_, r) =>
          Array.from({ length: 9 }, (_, c) => (
            <circle class="vec" cx={210 + c * 10} cy={24 + r * 11} r="2.2" style={`opacity:${(0.25 + (((r * 9 + c) * 53) % 70) / 100).toFixed(2)}`} />
          )),
        )}
        <path class="flow" d="M306,51 H332" />
        <rect class="answer" x="340" y="34" width="46" height="34" rx="8" />
        <line class="txt strong" x1="348" x2="378" y1="46" y2="46" />
        <line class="txt strong" x1="348" x2="368" y1="56" y2="56" />
      </g>
    )}

    {slug === 'doc-parser' && (
      <g class="parse">
        <rect class="page" x="40" y="8" width="120" height="88" rx="4" />
        {[18, 25, 32].map((y) => <line class="txt" x1="50" x2="150" y1={y} y2={y} />)}
        <rect class="img" x="50" y="40" width="40" height="28" rx="2" />
        {[44, 51, 58, 65].map((y) => <line class="txt" x1="98" x2="150" y1={y} y2={y} />)}
        <g class="table">
          <rect x="50" y="74" width="100" height="16" rx="1.5" />
          <line x1="50" x2="150" y1="82" y2="82" />
          {[75, 100, 125].map((x) => <line x1={x} x2={x} y1="74" y2="90" />)}
        </g>
        <rect class="box" x="46" y="14" width="108" height="22" rx="3" />
        <rect class="box" x="46" y="36" width="48" height="36" rx="3" />
        <rect class="box" x="46" y="71" width="108" height="22" rx="3" />
        <path class="flow" d="M172,52 H204" />
        {[['text', 24], ['image', 52], ['table', 80]].map(([label, y]) => (
          <g>
            <rect class="out" x="214" y={(y as number) - 10} width="150" height="20" rx="4" />
            <text x="224" y={(y as number) + 3.5}>{`${label}`}</text>
            <text class="dim" x="354" y={(y as number) + 3.5} text-anchor="end">{label === 'table' ? 'Q&A' : label === 'image' ? '.png' : '.md / .json'}</text>
          </g>
        ))}
      </g>
    )}
  </svg>
  )}
  <span class="cap" title={slug === 'energy-price-forecasting' ? `Data: ${energy.license}` : undefined}>{captions[slug]}</span>
</div>

<style>
  .cover {
    position: relative;
    container: cover / inline-size;
    height: 92px;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background:
      linear-gradient(180deg, color-mix(in oklab, var(--c) 7%, transparent), transparent 70%),
      radial-gradient(circle at 1px 1px, var(--border) 1px, transparent 0) 0 0 / 14px 14px;
  }

  .cover.tall {
    height: 116px;
  }

  .t-agents { --c: var(--t-agents); }
  .t-mlops { --c: var(--t-mlops); }
  .t-rag { --c: var(--t-rag); }
  .t-speech { --c: var(--t-speech); }

  svg {
    position: absolute;
    inset: 8px 12px 18px;
    width: calc(100% - 24px);
    height: calc(100% - 26px);
  }

  .cap {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 5px;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: var(--font-sans);
    font-size: 10px;
    color: var(--text-faint);
    white-space: nowrap;
  }

  /* Checklist (ListingAudit) */
  .checks {
    position: absolute;
    inset: 12px 16px 22px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: 4px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 12.5px;
    color: var(--text-muted);
  }

  .checks li {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mark {
    display: grid;
    place-items: center;
    flex: none;
    width: 16px;
    height: 16px;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 700;
    color: var(--positive);
    background: color-mix(in oklab, var(--positive) 15%, transparent);
  }

  .bad {
    color: var(--text);
  }

  .bad .mark {
    color: var(--t-speech);
    background: color-mix(in oklab, var(--t-speech) 18%, transparent);
  }

  @container cover (max-width: 420px) {
    .checks {
      inset-inline: 12px;
      column-gap: 12px;
      font-size: 11.5px;
    }

    .checks li {
      gap: 6px;
    }
  }

  @container cover (min-width: 640px) {
    .checks {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Prices */
  .prices .tick {
    stroke: var(--border);
    stroke-dasharray: 2 3;
  }

  .prices .line {
    fill: none;
    stroke: var(--c);
    stroke-width: 1.6;
    stroke-linejoin: round;
  }

  .prices .mark {
    fill: var(--bg);
    stroke: var(--c);
    stroke-width: 1.5;
  }

  .prices text,
  .parse text {
    font-family: var(--font-sans);
    font-size: 8.5px;
    fill: var(--text-muted);
  }

  /* Waveform */
  .wave rect {
    fill: var(--c);
    opacity: 0.8;
  }

  /* RAG pipeline */
  .page,
  .answer,
  .chunk,
  .out {
    fill: var(--surface);
    stroke: var(--border-strong);
  }

  .chunk {
    stroke: color-mix(in oklab, var(--c) 60%, transparent);
  }

  .answer {
    stroke: var(--c);
  }

  .txt {
    stroke: var(--text-faint);
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.6;
  }

  .txt.strong {
    stroke: var(--c);
    opacity: 0.9;
  }

  .vec {
    fill: var(--c);
  }

  .flow {
    stroke: var(--text-faint);
    stroke-width: 1.2;
    fill: none;
    marker-end: none;
  }

  /* Parser */
  .img {
    fill: color-mix(in oklab, var(--c) 18%, var(--surface));
  }

  .table rect,
  .table line {
    fill: none;
    stroke: var(--text-faint);
    stroke-width: 0.8;
  }

  .box {
    fill: none;
    stroke: var(--c);
    stroke-width: 1;
    stroke-dasharray: 3 2;
  }

  .parse .dim {
    fill: var(--text-faint);
  }
</style>
