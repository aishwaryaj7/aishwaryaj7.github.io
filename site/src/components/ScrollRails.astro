---
// Adds a visible, draggable slider under every horizontally scrolling row marked [data-scroller],
// so it's obvious there is more to the right. Hidden automatically when everything fits.
---

<script>
  const CHEVRON = (d: string) =>
    `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${d}"/></svg>`;

  for (const el of document.querySelectorAll<HTMLElement>('[data-scroller]')) {
    const rail = document.createElement('div');
    rail.className = 'rail';
    rail.innerHTML = `
      <button type="button" class="rail-btn" data-dir="-1" aria-label="Scroll left">${CHEVRON('m15 18-6-6 6-6')}</button>
      <div class="rail-track"><div class="rail-thumb"></div></div>
      <button type="button" class="rail-btn" data-dir="1" aria-label="Scroll right">${CHEVRON('m9 18 6-6-6-6')}</button>`;
    el.after(rail);

    const track = rail.querySelector<HTMLElement>('.rail-track')!;
    const thumb = rail.querySelector<HTMLElement>('.rail-thumb')!;
    const [prev, next] = rail.querySelectorAll<HTMLButtonElement>('.rail-btn');
    const max = () => el.scrollWidth - el.clientWidth;

    const update = () => {
      const overflow = max() > 4;
      rail.hidden = !overflow;
      el.toggleAttribute('data-overflow', overflow);
      if (!overflow) return;
      thumb.style.width = `${(el.clientWidth / el.scrollWidth) * 100}%`;
      const room = track.clientWidth - thumb.offsetWidth;
      thumb.style.transform = `translateX(${(el.scrollLeft / max()) * room}px)`;
      const atStart = el.scrollLeft < 4;
      const atEnd = el.scrollLeft > max() - 4;
      el.toggleAttribute('data-at-end', atEnd);
      prev.disabled = atStart;
      next.disabled = atEnd;
    };

    el.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(el);
    new ResizeObserver(update).observe(track);
    update();

    for (const btn of [prev, next]) {
      btn.addEventListener('click', () =>
        el.scrollBy({ left: Number(btn.dataset.dir) * el.clientWidth * 0.8, behavior: 'smooth' }),
      );
    }

    // Drag the thumb, or press anywhere on the track to jump there
    let grab = 0;
    const scrollTo = (clientX: number) => {
      const box = track.getBoundingClientRect();
      const room = box.width - thumb.offsetWidth;
      const x = Math.min(Math.max(clientX - box.left - grab, 0), room);
      el.scrollLeft = (x / room) * max();
    };
    track.addEventListener('pointerdown', (e) => {
      const t = thumb.getBoundingClientRect();
      grab = e.target === thumb ? e.clientX - t.left : thumb.offsetWidth / 2;
      track.setPointerCapture(e.pointerId);
      track.dataset.dragging = '';
      el.style.scrollSnapType = 'none';
      scrollTo(e.clientX);
    });
    track.addEventListener('pointermove', (e) => {
      if (track.hasPointerCapture(e.pointerId)) scrollTo(e.clientX);
    });
    const release = () => {
      delete track.dataset.dragging;
      el.style.scrollSnapType = '';
    };
    track.addEventListener('pointerup', release);
    track.addEventListener('pointercancel', release);
  }
</script>

<style is:global>
  .rail {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
  }

  .rail[hidden] {
    display: none;
  }

  .rail-track {
    position: relative;
    flex: 1;
    height: 6px;
    border-radius: 999px;
    background: var(--border);
    cursor: pointer;
    touch-action: none;
  }

  /* Bigger hit area than the visible bar */
  .rail-track::before {
    content: '';
    position: absolute;
    inset: -10px 0;
  }

  .rail-thumb {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    min-width: 32px;
    border-radius: inherit;
    background: var(--text-faint);
    cursor: grab;
    transition: background-color 0.15s;
  }

  .rail-track:hover .rail-thumb,
  .rail-track[data-dragging] .rail-thumb {
    background: var(--text-muted);
  }

  .rail-track[data-dragging] .rail-thumb {
    cursor: grabbing;
  }

  .rail-btn {
    display: grid;
    place-items: center;
    flex: none;
    width: 30px;
    height: 30px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, opacity 0.15s;
  }

  .rail-btn:hover:not(:disabled) {
    color: var(--text);
    border-color: var(--text-faint);
  }

  .rail-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  /* Fade the right edge while there is more to see */
  [data-scroller][data-overflow]:not([data-at-end]) {
    -webkit-mask-image: linear-gradient(90deg, #000 78%, transparent);
    mask-image: linear-gradient(90deg, #000 78%, transparent);
  }
</style>
