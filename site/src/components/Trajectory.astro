---
import { timeline } from '../data/site';
---

<ol class="track" aria-label="Career, newest first" data-scroller>
  {timeline.map((t) => (
    <li class:list={['stop', t.kind, { current: t.current }]}>
      <span class="node" aria-hidden="true"></span>
      <span class="years">{t.years}</span>
      <span class="role">{t.role}</span>
      <span class="org">{t.org}</span>
      {t.note && <span class="note">{t.note}</span>}
    </li>
  ))}
</ol>

<style>
  .track {
    --node: 11px;
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The rail: one line through every node, brightening towards "now" */
  .track::before {
    content: '';
    position: absolute;
    top: calc(var(--node) / 2);
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--positive), var(--border-strong) 40%, var(--border) 100%);
  }

  .stop {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .node {
    position: relative;
    width: var(--node);
    height: var(--node);
    margin-bottom: 14px;
    border-radius: 50%;
    background: var(--text);
    box-shadow: 0 0 0 4px var(--bg);
  }

  .study .node {
    background: var(--bg);
    border: 1.5px solid var(--text-muted);
  }

  .current .node {
    background: var(--positive);
  }

  @media (prefers-reduced-motion: no-preference) {
    .current .node::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: var(--positive);
      animation: ping 2.4s ease-out infinite;
    }

    @keyframes ping {
      0% { transform: scale(1); opacity: 0.55; }
      70%, 100% { transform: scale(2.4); opacity: 0; }
    }
  }

  .years {
    font-family: var(--font-sans);
    font-size: 11.5px;
    color: var(--text-faint);
    white-space: nowrap;
  }

  .current .years {
    color: var(--positive);
  }

  .role {
    margin-top: 4px;
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .org {
    font-size: 13.5px;
    color: var(--text-muted);
  }

  .note {
    margin-top: 6px;
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--text-faint);
  }

  /* Narrow screens: same horizontal track, swiped sideways */
  @media (max-width: 820px) {
    .track {
      grid-template-columns: repeat(6, 160px);
      gap: 16px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      margin-inline: calc(-1 * var(--gutter));
      padding: 4px var(--gutter) 8px;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }

    .track::-webkit-scrollbar {
      display: none;
    }

    .track::before {
      left: var(--gutter);
      right: auto;
      width: calc(6 * 160px + 5 * 16px);
      top: calc(4px + var(--node) / 2);
    }

    .stop {
      scroll-snap-align: start;
    }
  }
</style>
