---
// One real day of day-ahead prices (the forecasting target), from scripts/build-data.mjs.
import energy from '../../data/generated/energy-prices.json';

const W = 680;
const H = 230;
const m = { l: 44, r: 12, t: 16, b: 28 };
const p = energy.prices;
const lo = Math.floor(Math.min(...p) / 25) * 25;
const hi = Math.ceil(Math.max(...p) / 25) * 25;
const x = (i: number) => m.l + (i / (p.length - 1)) * (W - m.l - m.r);
const y = (v: number) => m.t + (1 - (v - lo) / (hi - lo)) * (H - m.t - m.b);
const line = p.map((v, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(v).toFixed(1)}`).join('');
const yTicks = Array.from({ length: Math.round((hi - lo) / 50) + 1 }, (_, k) => lo + k * 50).filter((v) => v <= hi);
const iMin = p.indexOf(Math.min(...p));
const iMax = p.indexOf(Math.max(...p));
const hh = (i: number) => `${String(Math.floor(i / 4)).padStart(2, '0')}:${String((i % 4) * 15).padStart(2, '0')}`;
const day = new Date(energy.day).toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
---

<figure class="chart t-mlops">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Day-ahead electricity prices in Germany and Luxembourg on ${day}, from €${p[iMin]} to €${p[iMax]} per MWh`}>
    <defs>
      <linearGradient id="pd-fill" x1="0" x2="0" y1="0" y2="1">
        <stop offset="0" stop-color="var(--c)" stop-opacity="0.3" />
        <stop offset="1" stop-color="var(--c)" stop-opacity="0" />
      </linearGradient>
    </defs>
    {yTicks.map((v) => (
      <g>
        <line class="grid" x1={m.l} x2={W - m.r} y1={y(v)} y2={y(v)} />
        <text class="ax" x={m.l - 8} y={y(v) + 3.5} text-anchor="end">{v}</text>
      </g>
    ))}
    {[0, 24, 48, 72, 95].map((i) => (
      <text class="ax" x={x(i)} y={H - 8} text-anchor="middle">{i === 95 ? '24:00' : hh(i)}</text>
    ))}
    <path d={`${line}L${x(p.length - 1)},${H - m.b}L${x(0)},${H - m.b}Z`} fill="url(#pd-fill)" />
    <path class="line" d={line} />
    <circle class="pt" cx={x(iMax)} cy={y(p[iMax])} r="3.5" />
    <circle class="pt" cx={x(iMin)} cy={y(p[iMin])} r="3.5" />
    <text class="lab" x={x(iMax)} y={y(p[iMax]) - 9} text-anchor="middle">€{p[iMax]} at {hh(iMax)}</text>
    <text class="lab" x={x(iMin) - 6} y={y(p[iMin]) - 9} text-anchor="end">€{p[iMin]} at {hh(iMin)}</text>
    <text class="ax unit" x={m.l} y={10}>€/MWh</text>
  </svg>
  <figcaption class="source">Germany, day-ahead, {day} · Source: SMARD.de via Energy-Charts, CC BY 4.0</figcaption>
</figure>

<style>
  .chart {
    margin: 1.6em 0;
  }

  svg {
    width: 100%;
    height: auto;
    padding: 12px 8px 4px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-subtle);
  }

  .t-mlops {
    --c: var(--t-mlops);
  }

  .source {
    margin-top: 8px;
    font-size: 11.5px;
    color: var(--text-faint);
  }

  .grid {
    stroke: var(--border);
  }

  .ax {
    font-family: var(--font-sans);
    font-size: 10px;
    fill: var(--text-faint);
  }

  .line {
    fill: none;
    stroke: var(--c);
    stroke-width: 1.8;
    stroke-linejoin: round;
  }

  .pt {
    fill: var(--bg);
    stroke: var(--c);
    stroke-width: 1.6;
  }

  .lab {
    font-family: var(--font-sans);
    font-size: 10.5px;
    fill: var(--text-muted);
  }
</style>
