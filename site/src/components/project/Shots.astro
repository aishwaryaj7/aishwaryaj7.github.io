---
// Screenshots from the project's demo video. Click to open the full-size image.
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props {
  shots: { src: ImageMetadata; alt: string; caption: string }[];
}
const { shots } = Astro.props;
const full = await Promise.all(shots.map((s) => getImage({ src: s.src, width: 1600, format: 'webp' })));
---

<div class:list={['shots', { single: shots.length === 1 }]}>
  {shots.map((s, i) => (
    <figure class="shot">
      <a href={full[i].src} target="_blank" rel="noopener" aria-label={`Open full size: ${s.alt}`}>
        <Image src={s.src} alt={s.alt} widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, 680px" format="webp" />
      </a>
      <figcaption>{s.caption}</figcaption>
    </figure>
  ))}
</div>

<style>
  .shots {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin: 1.6em 0;
  }

  .shots.single {
    grid-template-columns: 1fr;
  }

  .shot {
    margin: 0;
  }

  figcaption {
    margin-top: 8px;
    font-size: 13px;
    line-height: 1.45;
    color: var(--text-muted);
  }

  a {
    display: block;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg-subtle);
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  a:hover {
    border-color: var(--text-faint);
    box-shadow: var(--shadow);
  }

  a :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.4s var(--ease);
  }

  a:hover :global(img) {
    transform: scale(1.015);
  }

  @media (max-width: 600px) {
    .shots {
      grid-template-columns: 1fr;
    }
  }
</style>
