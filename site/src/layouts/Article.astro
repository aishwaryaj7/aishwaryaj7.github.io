---
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import Toc from '../components/Toc.astro';
import '../styles/prose.css';

interface Props {
  title: string;
  description: string;
  headings: MarkdownHeading[];
  back: { href: string; label: string };
  next?: { href: string; label: string; title: string };
}

const { title, description, headings, back, next } = Astro.props;
---

<Base title={title} description={description} type="article">
  <div class="progress" aria-hidden="true"><span data-progress></span></div>
  <div class="container layout">
    <article class="main">
      <a href={back.href} class="back"><Icon name="arrow-left" size={14} />{back.label}</a>
      <header class="head">
        <slot name="header" />
      </header>
      <div class="prose">
        <slot />
      </div>
      {next && (
        <a href={next.href} class="next">
          <span class="eyebrow">{next.label}</span>
          <span class="next-title">{next.title}</span>
          <Icon name="arrow-up-right" size={18} />
        </a>
      )}
    </article>
    <aside class="side">
      <Toc headings={headings} />
    </aside>
  </div>
</Base>

<script>
  import '../scripts/article.ts';

  // Reading progress: a thin line under the header
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const article = document.querySelector<HTMLElement>('.main');
  if (bar && article) {
    const update = () => {
      const start = article.offsetTop;
      const end = start + article.offsetHeight - innerHeight;
      bar.style.transform = `scaleX(${Math.min(1, Math.max(0, (scrollY - start) / Math.max(1, end - start)))})`;
    };
    update();
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
  }
</script>

<style>
  .progress {
    position: sticky;
    top: var(--header-h);
    z-index: 40;
    height: 2px;
    margin-bottom: -2px;
  }

  .progress span {
    display: block;
    height: 100%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 200px;
    gap: 72px;
    max-width: calc(var(--w-prose) + 200px + 72px + 2 * var(--gutter));
    padding-top: clamp(28px, 5vw, 48px);
    padding-bottom: clamp(56px, 8vw, 96px);
  }

  .main {
    min-width: 0;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 28px;
    font-size: 13.5px;
    color: var(--text-muted);
    transition: color 0.15s;
  }

  .back:hover {
    color: var(--text);
  }

  .head {
    margin-bottom: 36px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--border);
  }

  .next {
    position: relative;
    display: grid;
    gap: 6px;
    margin-top: 64px;
    padding: 22px 56px 22px 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .next:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow);
  }

  .next-title {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .next :global(svg) {
    position: absolute;
    right: 22px;
    top: 50%;
    translate: 0 -50%;
    color: var(--text-faint);
    transition: transform 0.2s var(--ease), color 0.15s;
  }

  .next:hover :global(svg) {
    color: var(--text);
    transform: translate(2px, -2px);
  }

  @media (max-width: 1080px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      max-width: calc(var(--w-prose) + 2 * var(--gutter));
    }

    .side {
      display: none;
    }
  }
</style>
